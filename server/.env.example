# Copy outside the public web root. Empty tokens intentionally prevent startup.
VOICE_TOKENS_JSON='{}'
VOICE_ALLOWED_ORIGINS=https://jwsky.github.io,http://localhost:8000
VOICE_HOST=127.0.0.1
VOICE_PORT=8787
